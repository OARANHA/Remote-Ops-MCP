{
  "name": "remote-ops-mcp",
  "version": "2.0.0-dev.0",
  "description": "Capability-scoped remote operations MCP control plane with OAuth, Agent Mesh, audit, read-only observation and allowlisted operator actions.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "check": "npm run build && bash test-e2e.sh",
    "agent": "node dist/agent/cli.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "ssh2": "^1.16.0",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  },
  "bin": {
    "wandora-ops-agent": "dist/agent/cli.js"
  }
}
