# Candidate overlay of the actual deployed DSH image. No dependency install,
# profile upgrade, credential provisioning, network listener or grant activation.
FROM ghcr.io/oaranha/deepharness-mcp@sha256:27d5784af8a472c305d1665a62944dc8508501e1d900f4e0eb2751d42c31b624
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
LABEL com.wandora.dsh.base-revision=9c1ac05bf9a0a3fa2ef9f95a3248f156c3fa5d15
COPY --chown=1000:1000 .ci-dsh-reviewed/deploy/mcp/run-operational.mjs .ci-dsh-reviewed/deploy/mcp/operational-host.mjs .ci-dsh-reviewed/deploy/mcp/private-read-listener.mjs /opt/wandora-mcp-verifier/mcp/
COPY --chown=1000:1000 integrations/deepharness/official-dsh-platform-admin.mjs integrations/deepharness/platform-admin-private-host.mjs integrations/deepharness/platform-admin-contract.mjs integrations/deepharness/platform-admin-durable-replay.mjs integrations/deepharness/platform-admin-private-relay.mjs integrations/deepharness/platform-admin-host-dispatch.mjs integrations/deepharness/platform-admin-host-readiness.mjs integrations/deepharness/platform-admin-private-http-handler.mjs /opt/wandora-mcp-verifier/platform-admin/
USER 1000:1000
CMD ["node","-e","console.log('DSH_PLATFORM_CANDIDATE_DISABLED')"]
