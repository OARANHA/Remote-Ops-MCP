# Built with Dockerfile's built-in syntax; do not resolve an extra unpinned
# external BuildKit frontend while qualifying a digest-pinned Node 22 base.
# REVIEW CANDIDATE ONLY. Supply a separately reviewed, digest-pinned Node 22
# base image via the audited pinned ARG default (optionally override by approved digest).
# No packages, plugins, credentials, agent tools or Docker socket are installed.
ARG DSH_RELAY_NODE_BASE_IMAGE=docker.io/library/node@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562
FROM ${DSH_RELAY_NODE_BASE_IMAGE}
ENV NODE_ENV=production
WORKDIR /opt/wandora-dsh-relay
COPY integrations/deepharness/private-bridge-client.mjs \
     integrations/deepharness/agent-mesh-unix-relay.mjs \
     integrations/deepharness/agent-mesh-unix-listener.mjs \
     integrations/deepharness/agent-mesh-unix-relay-run.mjs \
     integrations/deepharness/platform-admin-contract.mjs \
     integrations/deepharness/platform-admin-private-http-handler.mjs ./
# Review default is non-root. Compose must override with the distinct,
# operator-verified relay UID and GID, never the host ops-mcp UID.
USER 65534:65534
CMD ["node","/opt/wandora-dsh-relay/agent-mesh-unix-relay-run.mjs"]
