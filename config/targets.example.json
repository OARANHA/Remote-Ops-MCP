      "enabled": true,
      "transport": "ssh"
    },
    {
      "id": "demo-mock",
      "host": "mock",
      "port": 22,
      "username": "mock",
      "environment": "staging",
      "capabilityProfile": "read-only",
      "allowedPaths": ["/opt/wandora"],
      "allowedDockerContainers": ["*"],
      "allowedServices": ["*"],
      "allowedGitRepos": ["*"],
      "enabled": true,
      "transport": "mock"
    }
  ]
