{
  "targets": [
    {
      "id": "wandora-prod",
      "host": "host.docker.internal",
      "port": 22,
      "username": "ops-mcp",
      "keyFile": "/app/secrets/ops-mcp",
      "hostKeyFingerprint": "SHA256:COLE-AQUI-O-FINGERPRINT-DO-PASSO-2",
      "environment": "production",
      "capabilityProfile": "prod-read-mostly",
      "allowedPaths": ["/opt/wandora"],
      "allowedDockerContainers": [],
      "allowedServices": [],
