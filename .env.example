PORT=3000
AUTH_MODE=oauth
MCP_PASSWORD=troque-por-uma-senha-forte-de-autorizacao
ADMIN_PASSWORD=troque-por-uma-senha-administrativa-diferente
AUTH_SECRET=troque-pelo-resultado-de-openssl-rand-hex-32
PUBLIC_BASE_URL=https://mcp.wandora.com.br
TZ=UTC
MOCK_MODE=0
REMOTE_OPS_HOME=/opt/remote-ops-mcp
REMOTE_OPS_BIND_PORT=3005
REMOTE_OPS_IMAGE=ghcr.io/oaranha/remote-ops-mcp:main
MAX_OUTPUT_BYTES=262144
MAX_LOG_LINES=500
READ_FILE_MAX_BYTES=65536
RATE_LIMIT_PER_MIN=120
OAUTH_MAX_CLIENTS=100
OAUTH_PENDING_CLIENT_TTL_HOURS=24
PER_TARGET_CONCURRENCY=4
COMMAND_TIMEOUT_MS=15000
CONNECT_TIMEOUT_MS=10000

# Agent/operator Docker proxy (host-specific; default deny)
DOCKER_GID=999
ALLOWED_DOCKER_CONTAINERS=app-web
ALLOWED_DOCKER_EXEC_CONTAINERS=
ALLOWED_DOCKER_EXEC_PROGRAMS=
ALLOWED_DOCKER_ACTIONS=
