PORT=3000
AUTH_MODE=oauth
MCP_PASSWORD=troque-por-uma-senha-forte-de-autorizacao
ADMIN_PASSWORD=troque-por-uma-senha-administrativa-diferente
AUTH_SECRET=troque-pelo-resultado-de-openssl-rand-hex-32
PUBLIC_BASE_URL=https://mcp.wandora.com.br
TZ=UTC
MOCK_MODE=0
REMOTE_OPS_HOME=/opt/remote-ops-mcp
REMOTE_OPS_BIND_PORT=3005
REMOTE_OPS_IMAGE=ghcr.io/oaranha/remote-ops-mcp:main
MAX_OUTPUT_BYTES=262144
MAX_LOG_LINES=500
READ_FILE_MAX_BYTES=65536
RATE_LIMIT_PER_MIN=120
OAUTH_MAX_CLIENTS=100
OAUTH_PENDING_CLIENT_TTL_HOURS=24
PER_TARGET_CONCURRENCY=4
COMMAND_TIMEOUT_MS=15000
CONNECT_TIMEOUT_MS=10000
WANDORA_EXEC_MAX_SESSIONS=48

# Portainer API. O access token NÃO fica neste arquivo; use /app/secrets/portainer_api_key.
PORTAINER_URL=https://portainer.wandora.com.br
PORTAINER_TIMEOUT_MS=20000

# Agent/operator Docker proxy (host-specific; default deny)
DOCKER_GID=999
ALLOWED_DOCKER_CONTAINERS=app-web
ALLOWED_DOCKER_EXEC_CONTAINERS=
ALLOWED_DOCKER_EXEC_PROGRAMS=
ALLOWED_DOCKER_ACTIONS=
ALLOWED_DOCKER_IMAGE_LOAD_ROOTS=
ALLOWED_DOCKER_CANDIDATE_IMAGE_PREFIXES=
ALLOWED_DOCKER_CANDIDATE_NETWORKS=
ALLOWED_DOCKER_CANDIDATE_NAME_PREFIXES=
ALLOWED_DOCKER_CANDIDATE_HOST_PORTS=
ALLOWED_DOCKER_CANDIDATE_CONTAINER_PORTS=

# Elus VendaERP DANFE canary semantic capability (default deny).
# Configure only after the exact candidate image has passed CI. The image MUST be pinned by sha256 digest.
# Portainer access is target-local via Agent Mesh; the control plane never stores the managed host token.
# Managed-host token: /var/lib/wandora-ops-agent/secrets/portainer_api_key (owner ops-mcp, mode 0600).
ELUS_DANFE_CANARY_SOURCE_CONTAINER=
ELUS_DANFE_CANARY_IMAGE=
ELUS_DANFE_CANARY_REVISION=
ELUS_DANFE_CANARY_CONTAINER_NAME=wandora-elus-danfe-canary-once
ELUS_DANFE_CANARY_RECEIPT_NAME=wandora-elus-danfe-canary-receipt
ELUS_DANFE_CANARY_NETWORK=bridge

# Optional read-only bind used only with docker-compose.image-load-root.yml.
DOCKER_IMAGE_LOAD_ROOT_HOST=
DOCKER_IMAGE_LOAD_ROOT_CONTAINER=/opt/wandora/ops-workspace
DOCKER_IMAGE_LOAD_ROOT_GID=
